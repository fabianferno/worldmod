# Base Sepolia. The public endpoint works for reads and light testing;
# a provider key is worth having before deploy day.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer. Fund it from a Base Sepolia faucet before running the deploy
# script. This key only ever holds testnet value.
PRIVATE_KEY=

# Optional, for contract verification.
BASESCAN_API_KEY=
