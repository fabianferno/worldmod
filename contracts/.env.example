# Hedera testnet, via Hashio (Hedera's JSON-RPC relay). Chain id 296.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# Deployer. Fund it with testnet HBAR before running the deploy script —
# this key only ever holds testnet value.
PRIVATE_KEY=

# Ethereum Sepolia — kept as the fallback network (see contracts/deployments.json's
# "11155111" entry). Only needed if redeploying or re-running the Sepolia-side
# fork tests.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
